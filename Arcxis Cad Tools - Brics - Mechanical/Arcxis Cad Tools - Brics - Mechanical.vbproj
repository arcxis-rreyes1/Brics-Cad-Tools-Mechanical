<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>Arcxis_Cad_Tools_Brics</RootNamespace>
    <AssemblyName>Arcxis Cad Tools - Brics - Mechanical</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- Enable full debugging -->
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    
    <!-- VB specific options -->
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- Suppress Windows-specific warnings -->
    <NoWarn>$(NoWarn);CA1416;42016,41999,42017,42018,42019,42032,42036,42020,42021,42022,42353,42354,42355</NoWarn>
    
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    
    <!-- Fix VB runtime ambiguity by removing auto-imports -->
    <DisableImplicitNamespaceImports>false</DisableImplicitNamespaceImports>
    <NoVBRuntimeReference>false</NoVBRuntimeReference>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BrxMgd">
      <HintPath>..\..\..\..\..\..\Program Files\Bricsys\BricsCAD V26 en_US\BrxMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TD_Mgd">
      <HintPath>..\..\..\..\..\..\Program Files\Bricsys\BricsCAD V26 en_US\TD_Mgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Form_MechanicalPrinting.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>